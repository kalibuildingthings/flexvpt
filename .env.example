# ElevenLabs: API key and the agent configured from agent/
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional: voice for the card voiceovers (npm run voiceovers). Use the agent's voice id so they match.
ELEVENLABS_VOICE_ID=
# Shared secret sent by the agent's webhook tools in the x-flexvpt-secret header (min 16 chars)
TOOL_WEBHOOK_SECRET=
# Key the browser sends to /api/agent/signed-url and /api/split/save (min 16 chars).
# NEXT_PUBLIC_ means it ships in the page bundle: it blocks drive-by callers, it is not a user credential.
NEXT_PUBLIC_CLIENT_API_KEY=
# Notion integration token and the database's data source id
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
